# Copy to .env and fill values locally. Do not commit .env.
PAIRING_CODE=
MQTT_URL=
APP_BROKER_URL=
MQTT_USER=
MQTT_PASSWORD=
# Each device needs its measured internal height in cm, e.g.:
# DEVICES_JSON=[{"id":"device-a","topic":"smartbin/device-a","heightCm":45}]
DEVICES_JSON=[]
# Optional Expo enhanced push security access token (server only).
EXPO_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
