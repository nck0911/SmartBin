# Copy to .env. Optional for Expo Go; configure for APK/push builds.
EAS_PROJECT_ID=
# MQTT over secure WebSocket, shared with backend APP_BROKER_URL.
EXPO_PUBLIC_MQTT_URL=wss://broker.hivemq.com:8884/mqtt
GOOGLE_SERVICES_JSON=./google-services.json
# Backend URL. Production requires HTTPS; development also permits private LAN HTTP.
# Example on the same Wi-Fi: http://192.168.1.10:8787 (use your computer's actual IP).
# Restart Expo after changing.
EXPO_PUBLIC_BACKEND_URL=
