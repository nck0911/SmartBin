{
  "expo": {
    "name": "SmartBin",
    "slug": "smartbin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/smartbin-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F6F3",
        "foregroundImage": "./assets/smartbin-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/smartbin-icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/smartbin-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F3F6F3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép dùng camera để quét mã QR trên thùng rác.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "smartbin",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5b8bd0c1-878d-4ea6-8465-8245204c4207"
      }
    }
  }
}
